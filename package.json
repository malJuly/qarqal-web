{
  "name": "qarqal-landing-page",
  "version": "1.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "preview": "npx --yes serve@14 dist/qarqal_landing_page_angular/browser",
    "check:i18n": "node scripts/check-i18n.mjs"
  },
  "prettier": {
    "printWidth": 100,
    "singleQuote": true,
